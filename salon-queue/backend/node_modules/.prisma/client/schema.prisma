// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum EntryStatus {
  WAITING
  CALLED
  IN_CHAIR
  DONE
  CANCELLED
  NO_SHOW
}

enum BarberStatus {
  AVAILABLE
  BUSY
  ON_BREAK
  OFF_DUTY
}

enum StaffRole {
  RECEPTION
  BARBER
  OWNER
}

// ─────────────────────────────────────────────
// Queue Entry
// ─────────────────────────────────────────────

model QueueEntry {
  id             String         @id @default(uuid())
  tokenNumber    Int            @unique @default(autoincrement())
  customerName   String
  phone          String // normalised 10-digit string
  status         EntryStatus    @default(WAITING)
  barberPref     String? // "ANY" | barber name (Ravi/Amit/Imran)
  assignedBarber String? // set when CALLED
  calledAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  joinedAt       DateTime       @default(now())
  isWalkin       Boolean        @default(false)
  services       EntryService[]

  @@index([status])
  @@index([phone])
  @@index([status, joinedAt])
}

// Snapshot of each service at join time — never modified later
model EntryService {
  id          Int        @id @default(autoincrement())
  entry       QueueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId     String
  serviceId   Int // reference only; not a FK so edits don't cascade
  nameEn      String
  nameGu      String
  durationMin Int
  price       Int

  @@index([entryId])
}

// ─────────────────────────────────────────────
// Service Catalogue
// ─────────────────────────────────────────────

model Service {
  id          Int     @id @default(autoincrement())
  nameEn      String
  nameGu      String
  durationMin Int
  price       Int
  enabled     Boolean @default(true)
}

// ─────────────────────────────────────────────
// Staff Accounts
// ─────────────────────────────────────────────

model Staff {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  role         StaffRole
  barberName   String? // set only for BARBER role; matches Barber.name
}

// ─────────────────────────────────────────────
// Barbers
// ─────────────────────────────────────────────

model Barber {
  id     Int          @id @default(autoincrement())
  name   String       @unique
  status BarberStatus @default(AVAILABLE)
  onDuty Boolean      @default(true)
}

// ─────────────────────────────────────────────
// Salon-level Settings (single row, id = 1)
// ─────────────────────────────────────────────

model SalonSettings {
  id              Int     @id @default(1)
  onlineQueueOpen Boolean @default(true)
  closingTime     String  @default("21:00") // HH:MM, Asia/Kolkata
  openingTime     String  @default("09:00") // HH:MM, Asia/Kolkata
}
